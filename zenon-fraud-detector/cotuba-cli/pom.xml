<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
          <groupId>br.com.zenon</groupId>
          <artifactId>zenon-fraud-detector</artifactId>
          <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>br.com.zenon</groupId>
    <artifactId>cotuba-cli</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.com.zanon</groupId>
            <artifactId>cotuba-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.zanon</groupId>
            <artifactId>cotuba-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.zanon</groupId>
            <artifactId>cotuba-md</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.zanon</groupId>
            <artifactId>cotuba-pdf</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.zanon</groupId>
            <artifactId>cotuba-epub</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.zanon</groupId>
            <artifactId>cotuba-html</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>1.11.0</version>
        </dependency>
        
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.4.1</version>
			<scope>test</scope>
		</dependency>
    </dependencies>

    <build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugin</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
				<version>3.1.0</version>
				<configuration>
					<descriptors>
						<descriptor>src/assembly/distribution.xml</descriptor>
					</descriptors>
				</configuration>
			</plugin>

		</plugins>
	</build>
</project>